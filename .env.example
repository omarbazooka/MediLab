# MediLab AI local environment template.
# Copy to .env for local development. Never commit real credentials.

# development | testing | production
MEDILAB_ENV=development

# Development placeholder only. Production validation rejects this value.
SECRET_KEY=change-me-in-production-use-a-secure-random-key

# Local host connection. Docker Compose overrides DATABASE_URL for the web service.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medilab

HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

POSTGRES_DB=medilab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Optional: real PostgreSQL URL used only by marked integration tests.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medilab
