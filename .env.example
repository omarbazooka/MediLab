# ==============================================================================
# MediLab AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment: development | testing | production
FLASK_ENV=development

# Secret key for session security and cryptographic signing.
# In production, this MUST be set to a cryptographically secure random string (min 32 chars).
SECRET_KEY=change-me-in-production-use-a-secure-random-key

# Database Connection URL
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medilab

# Application Port
PORT=5000

# Structured Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL container settings (used by docker-compose)
POSTGRES_DB=medilab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
