# ==============================================================================
# MediLab AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Application Environment: development | testing | production
MEDILAB_ENV=development

# Secret key for session security and cryptographic signing (minimum 32 chars in production).
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Durable Application Database Connection URL (Supabase-hosted PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Disposable Integration-Test Database (Local Docker PostgreSQL + pgvector)
# CRITICAL SAFETY RULE: This must NEVER point to the main Supabase application database!
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medilab

# HTTP Server Configuration
HOST=0.0.0.0
PORT=5000

# Structured Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Phase 2 Embeddings & Hybrid RAG (Jina v3 @ 384d)
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=384
JINA_API_KEY=

# Phase 3 LLM Provider Configuration (Gemini-only runtime)
# LLM_PROVIDER: gemini (production/development) | fake (testing only)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Use a valid Gemini API key for the Google Generative Language API.
# Do not paste an OAuth client ID, Google Cloud project identifier, or other credential type here.
GEMINI_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.0

# Agent context & conversation limits
MAX_RECENT_MESSAGES=10
MAX_CUSTOMER_BOOKINGS=5
MAX_CLARIFICATION_ATTEMPTS=2
MAX_INPUT_LENGTH=1000
